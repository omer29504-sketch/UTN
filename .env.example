# ─────────────────────────────────────────────────────────────────────────────
# University Talent Network — environment template
# Copy to `.env.local` for apps/web and `.env` for apps/mobile / Supabase CLI.
# Never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# ── Supabase (Database, Auth, Realtime) ──────────────────────────────────────
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Expo only needs the public values (the same Supabase project).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Cloudflare R2 (S3-compatible object storage) ─────────────────────────────
# R2 → Manage R2 API Tokens → Create API token (Object Read & Write)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Optional. Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com

# Bucket names (create these three buckets in R2)
R2_BUCKET_PRIVATE_CREDENTIALS=private-credentials
R2_BUCKET_PITCH_VIDEOS=pitch-videos
R2_BUCKET_COMPANY_LOGOS=company-logos

# Public custom domain / r2.dev URL attached ONLY to the company-logos bucket.
# Example: https://logos.universitytalent.network
R2_PUBLIC_LOGOS_BASE_URL=

# Optional safety valve used by the presign route. Defaults: 600s upload, 300s private GET.
# R2_PRESIGN_UPLOAD_TTL_SECONDS=600
# R2_PRESIGN_DOWNLOAD_TTL_SECONDS=300

# ── Stripe (Employer credit packs + Candidate Priority Pro) ──────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Create these Prices in the Stripe Dashboard (one-time payments).
STRIPE_PRICE_CREDITS_5=price_xxx
STRIPE_PRICE_CREDITS_15=price_xxx
STRIPE_PRICE_CREDITS_30=price_xxx

# Candidate Priority Pro (subscription or one-time, depending on your launch model).
STRIPE_PRICE_CANDIDATE_PRO=price_xxx

# ── Optional: Admin bootstrap ────────────────────────────────────────────────
# The seed creates a local-only admin. For production, promote a user manually:
#   update public.profiles set role = 'admin' where email = 'you@your-domain.com';
# ADMIN_BOOTSTRAP_EMAIL=

# ── Abuse protection (strongly recommended in production) ────────────────────
# Distributed rate limiting via Upstash Redis REST. Without these values the
# limiter falls back to a per-instance in-memory bucket, which is only a
# best-effort ceiling on multi-instance deployments.
# Upstash console → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Extra browser origins allowed to call the API, comma-separated absolute URLs.
# The host the request arrived on is always allowed, so this is only needed for
# a second custom domain or a staging front end.
SECURITY_ALLOWED_ORIGINS=

